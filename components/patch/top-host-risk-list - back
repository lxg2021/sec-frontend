"use client"

import { Card, CardContent, CardHeader, CardTitle, CardDescription } from "@/components/ui/card"
import { Badge } from "@/components/ui/badge"
import { Button } from "@/components/ui/button"
import { AlertTriangle, Server, ExternalLink, BarChart3, ShieldAlert } from "lucide-react"
import type { TopHostRiskResponse, HostRiskInfo } from "@/types/patch-dashboard"
import { HostRiskLevel, SystemType } from "@/types/patch"
import Image from "next/image"
import { useMemo, memo } from "react"

interface TopHostRiskListProps {
  data: TopHostRiskResponse
}

// 常量移到组件外部避免重复创建
const riskLevelColors = {
  [HostRiskLevel.HIGH]: "bg-red-500 text-white",
  [HostRiskLevel.MEDIUM]: "bg-orange-500 text-white",
  [HostRiskLevel.LOW]: "bg-yellow-500 text-white",
  [HostRiskLevel.SAFE]: "bg-green-500 text-white",
} as const

const riskLevelLabels = {
  [HostRiskLevel.HIGH]: "高风险",
  [HostRiskLevel.MEDIUM]: "中风险",
  [HostRiskLevel.LOW]: "低风险",
  [HostRiskLevel.SAFE]: "安全",
} as const


const systemIcons = {
  [SystemType.WINDOWS]: "/icons/system/windows.svg",
  [SystemType.MACOS]: "/icons/system/macos.svg",
  [SystemType.LINUX]: "/icons/system/linux.svg",
} as const


const HostItem = memo(({ host, index }: HostItemProps) => {
  const totalUninstalledPatches = useMemo(() => {
    return host.criticalCounts + host.importantCounts + host.moderateCounts + host.lowCounts
  }, [host.criticalCounts, host.importantCounts, host.moderateCounts, host.lowCounts])

  const criticalPatches = useMemo(() => {
    return host.uninstalledPatches
      .filter((patch) => patch.severity === "Critical")
      .slice(0, 2)
  }, [host.uninstalledPatches])

  const criticalPatchesCount = useMemo(() => {
    return host.uninstalledPatches.filter((p) => p.severity === "Critical").length
  }, [host.uninstalledPatches])

  return (
    <div className="flex items-start space-x-3 p-3 rounded-lg border hover:bg-muted/50 transition-colors">
      {/* 排名序号 */}
      <div
        className="flex-shrink-0 w-6 h-6 rounded-full bg-primary text-primary-foreground text-xs font-bold flex items-center justify-center"
        aria-label={`排名第${index + 1}`}
      >
        {index + 1}
      </div>

      <div className="flex-1 min-w-0">
        {/* 主机信息 */}
        <div className="flex items-center gap-2 mb-1">
          <div className="w-4 h-4 relative flex-shrink-0">
            <Image
              src={systemIcons[host.system]}
              alt={`${host.system}系统`}
              width={16}
              height={16}
              loading="lazy"
            />
          </div>
          <span className="font-medium text-sm truncate" title={host.hostName}>
            {host.hostName}
          </span>
          <Badge
            className={`text-xs ${riskLevelColors[host.riskLevel]}`}
            aria-label={`风险等级: ${riskLevelLabels[host.riskLevel]}`}
          >
            {riskLevelLabels[host.riskLevel]}
          </Badge>
        </div>

        {/* 部门和分组 */}
        <div className="text-xs text-muted-foreground mb-2">
          {host.department} • {host.group}
        </div>

        {/* 补丁数量统计 */}
        <div className="flex flex-wrap gap-1 mb-2">
          {host.criticalCounts > 0 && (
            <Badge variant="destructive" className="text-xs">
              关键: {host.criticalCounts}
            </Badge>
          )}
          {host.importantCounts > 0 && (
            <Badge className="text-xs bg-orange-500 hover:bg-orange-600">重要: {host.importantCounts}</Badge>
          )}
          {host.moderateCounts > 0 && (
            <Badge className="text-xs bg-yellow-500 hover:bg-yellow-600">中等: {host.moderateCounts}</Badge>
          )}
          {host.lowCounts > 0 && (
            <Badge variant="secondary" className="text-xs">
              低: {host.lowCounts}
            </Badge>
          )}
        </div>

        {/* 未安装补丁总数 */}
        <div className="flex items-center justify-between">
          <span className="text-xs text-muted-foreground">
            未安装补丁: {totalUninstalledPatches} 个
          </span>
          <Button variant="ghost" size="sm" className="h-6 px-2 text-xs">
            查看详情
            <ExternalLink className="h-3 w-3 ml-1" />
          </Button>
        </div>

        {/* 关键补丁预览 */}
        {criticalPatchesCount > 0 && (
          <div className="mt-2 pt-2 border-t">
            <div className="text-xs text-muted-foreground mb-1">关键补丁:</div>
            <div className="space-y-1">
              {criticalPatches.map((patch) => (
                <div
                  key={patch.patchId}
                  className="text-xs bg-red-50 p-1 rounded"
                  title={patch.patchName}
                >
                  {patch.patchName}
                </div>
              ))}
              {criticalPatchesCount > 2 && (
                <div className="text-xs text-muted-foreground">
                  +{criticalPatchesCount - 2} 个更多...
                </div>
              )}
            </div>
          </div>
        )}
      </div>
    </div>
  )
})

HostItem.displayName = 'HostItem'

export function TopHostRiskList({ data }: TopHostRiskListProps) {
  const { topHosts, lastUpdated } = data

  return (
    <Card className="border-0 shadow-lg bg-white dark:bg-gray-800">
      <CardHeader className="flex flex-row items-center justify-between pb-4">
        <div className="flex items-center space-x-3">
          <div className="p-2 bg-purple-50 rounded-lg">
            <AlertTriangle className="h-5 w-5 text-purple-300" />
          </div>
          <div>
            <CardTitle className="text-lg font-medium text-gray-900">高风险主机 TOP10</CardTitle>
            <CardDescription className="text-sm text-gray-500">更新时间: {new Date(lastUpdated).toLocaleString("zh-CN")}</CardDescription>
          </div>
        </div>
      </CardHeader>
      <CardContent className="space-y-3">
        {topHosts.length === 0 ? (
          <div
            className="text-center py-8 text-muted-foreground"
            aria-label="暂无高风险主机"
          >
            <Server className="h-8 w-8 mx-auto mb-2 opacity-50" aria-hidden="true" />
            <p>暂无高风险主机</p>
          </div>
        ) : (
          <div className="max-h-96 overflow-y-auto pr-2 custom-scrollbar">
            {topHosts.map((host, index) => (
              <HostItem key={host.hostId} host={host} index={index} />
            ))}
          </div>
        )}
      </CardContent>
    </Card>
  )
}
